[Unit]
Description=Nautilus Polymarket Whale Follower (Micro Live Trading)
After=network-online.target
Wants=network-online.target
StartLimitBurst=5
StartLimitIntervalSec=300
ConditionPathExists=/home/elon-1/workspace/nautilus-trading/.guard/micro-live.ok

[Service]
Type=simple
User=elon-1
Group=elon-1
WorkingDirectory=/home/elon-1/workspace/nautilus-trading
ExecStart=/home/elon-1/workspace/nautilus-trading/venv/bin/python run_micro_live.py
Restart=always
RestartSec=30
StandardOutput=append:/home/elon-1/workspace/nautilus-trading/logs/micro_live_trading.log
StandardError=append:/home/elon-1/workspace/nautilus-trading/logs/micro_live_trading.log

# Environment
Environment=PYTHONUNBUFFERED=1
Environment=DAILY_LOSS_LIMIT=50

# Resource limits
LimitNOFILE=65536
MemoryMax=2G
MemoryHigh=1400M

[Install]
WantedBy=default.target
